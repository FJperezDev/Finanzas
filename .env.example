# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno de Finanzas.
# Copia este archivo a `.env` y rellena los valores reales.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Credenciales del usuario administrador ──────────────────
# Usuario único de la aplicación (login del móvil/web).
FINANZAS_ADMIN_USERNAME=admin
# Contraseña del administrador. OBLIGATORIA en producción.
FINANZAS_ADMIN_PASSWORD=cambia-esta-contrasena

# ── Firma y validez de los tokens JWT ───────────────────────
# Clave con la que se firman access/refresh tokens. Si no se
# define, se reutiliza DJANGO_SECRET_KEY.
FINANZAS_TOKEN_SECRET=
# Validez del access token (minutos). Defecto: 15
FINANZAS_ACCESS_TOKEN_MINUTES=15
# Validez del refresh token (días). Defecto: 7
FINANZAS_REFRESH_TOKEN_DAYS=7

# ── Django ──────────────────────────────────────────────────
# Clave secreta de Django. En producción debe ser real (no "django-insecure-").
# Genérala con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# "true" habilita el modo depuración (NUNCA en producción).
DEBUG=true
# Hosts permitidos separados por comas (defecto: *).
DJANGO_ALLOWED_HOSTS=*

# ── CORS (solo desarrollo, con Expo Web en otro puerto) ──────
CORS_ALLOW_ALL_ORIGINS=false

# ── Frontend (mobile) ────────────────────────────────────────
# URL del backend para desarrollo (Expo Web). En Docker se deja vacía
# porque nginx sirve la API bajo /api en el mismo origen.
EXPO_PUBLIC_API_URL=http://localhost:8000
